<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>doi_soat</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Đối soát số dòng và tổng tiền giữa Datalake và Lakehouse</description>
  <extended_description>Gọi hop/doi_soat_job.py (dùng chung reconcile.py với tool đối soát).
Mật khẩu KHÔNG khai báo ở đây: đặt biến môi trường DATALAKE_PASSWORD và LAKEHOUSE_PASSWORD cho tiến trình chạy Hop.
Mã thoát của script: 0 khớp hết, 1 có bảng lệch (khi FAIL_ON_MISMATCH=Y), 2 có bảng lỗi hoặc bị dừng, 3 cấu hình sai. Khác 0 thì workflow thất bại.</extended_description>
  <workflow_version>1.0</workflow_version>
  <created_user>-</created_user>
  <created_date>2026/11/11 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/11/11 00:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>TOOL_DIR</name>
      <default_value>/opt/tool_doi_soat</default_value>
      <description>Thư mục chứa reconcile.py và thư mục hop/</description>
    </parameter>
    <parameter>
      <name>PYTHON_BIN</name>
      <default_value>python3</default_value>
      <description>Python đã cài các gói trong requirements.txt</description>
    </parameter>
    <parameter>
      <name>RUN_DATE</name>
      <default_value/>
      <description>Ngày đối soát YYYY-MM-DD, để trống là hôm qua. Airflow truyền {{ ds }}</description>
    </parameter>
    <parameter>
      <name>ROWS_FILE</name>
      <default_value>danh_sach_bang.csv</default_value>
      <description>File danh sách bảng, đường dẫn tương đối tính từ TOOL_DIR</description>
    </parameter>
    <parameter>
      <name>OUT_DIR</name>
      <default_value>ket_qua</default_value>
      <description>Thư mục ghi ket_qua_doi_soat_YYYY-MM-DD.csv</description>
    </parameter>
    <parameter>
      <name>THRESHOLD</name>
      <default_value>0</default_value>
      <description>Ngưỡng % chênh lệch cho phép</description>
    </parameter>
    <parameter>
      <name>QUERY_TIMEOUT_MINUTES</name>
      <default_value>30</default_value>
      <description>Hủy query chạy quá số phút này</description>
    </parameter>
    <parameter>
      <name>QUERY_RETRIES</name>
      <default_value>1</default_value>
      <description>Số lần thử lại khi lỗi kết nối</description>
    </parameter>
    <parameter>
      <name>FAIL_ON_MISMATCH</name>
      <default_value>Y</default_value>
      <description>Y: có bảng lệch thì workflow thất bại; N: chỉ thất bại khi lỗi</description>
    </parameter>
    <parameter>
      <name>DATALAKE_HOST</name>
      <default_value/>
      <description>Host Spark Thrift của Datalake</description>
    </parameter>
    <parameter>
      <name>DATALAKE_PORT</name>
      <default_value>10000</default_value>
      <description>Port Spark Thrift của Datalake</description>
    </parameter>
    <parameter>
      <name>DATALAKE_USER</name>
      <default_value/>
      <description>User LDAP của Datalake</description>
    </parameter>
    <parameter>
      <name>DATALAKE_PARALLEL</name>
      <default_value>4</default_value>
      <description>Số query chạy cùng lúc trên Datalake (1-16)</description>
    </parameter>
    <parameter>
      <name>LAKEHOUSE_HOST</name>
      <default_value/>
      <description>Host Spark Thrift của Lakehouse</description>
    </parameter>
    <parameter>
      <name>LAKEHOUSE_PORT</name>
      <default_value>10000</default_value>
      <description>Port Spark Thrift của Lakehouse</description>
    </parameter>
    <parameter>
      <name>LAKEHOUSE_USER</name>
      <default_value/>
      <description>User LDAP của Lakehouse</description>
    </parameter>
    <parameter>
      <name>LAKEHOUSE_PARALLEL</name>
      <default_value>4</default_value>
      <description>Số query chạy cùng lúc trên Lakehouse (1-16)</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Chạy đối soát</name>
      <description>Chạy hop/doi_soat_job.py, mã thoát khác 0 thì thất bại</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${TOOL_DIR}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>#!/bin/bash
exec "${PYTHON_BIN}" hop/doi_soat_job.py --date "${RUN_DATE}" --rows "${ROWS_FILE}" --out-dir "${OUT_DIR}" --threshold "${THRESHOLD}" --timeout-minutes "${QUERY_TIMEOUT_MINUTES}" --retries "${QUERY_RETRIES}" --fail-on-mismatch "${FAIL_ON_MISMATCH}" --datalake-host "${DATALAKE_HOST}" --datalake-port "${DATALAKE_PORT}" --datalake-user "${DATALAKE_USER}" --datalake-parallel "${DATALAKE_PARALLEL}" --lakehouse-host "${LAKEHOUSE_HOST}" --lakehouse-port "${LAKEHOUSE_PORT}" --lakehouse-user "${LAKEHOUSE_USER}" --lakehouse-parallel "${LAKEHOUSE_PARALLEL}"
</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Thành công</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>464</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Đối soát thất bại</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <message>Đối soát có bảng lệch hoặc lỗi, xem log và file kết quả trong ${TOOL_DIR}/${OUT_DIR}</message>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Chạy đối soát</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Chạy đối soát</from>
      <to>Thành công</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Chạy đối soát</from>
      <to>Đối soát thất bại</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>
